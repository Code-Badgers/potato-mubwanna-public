# Copy this file to frontend/.env for local development.
# Never commit frontend/.env.

API_BASE_URL=http://localhost:8080/api

# Kakao Maps / Kakao platform keys
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_REST_API_KEY=
# Register this exact URI in Kakao Developers > Kakao Login > Redirect URI.
KAKAO_LOGIN_REDIRECT_URI=http://localhost:54631/

# Firebase Cloud Messaging
# The app uses a sanitized firebase_options.dart in Git. Provide real values
# locally or in release CI with --dart-define / --dart-define-from-file.
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=com.gamjamubwatna.frontend

# Legal notices. Release builds fail when any value is empty.
# Business registration number and home address are not exposed in the app.
LEGAL_BUSINESS_NAME=
LEGAL_REPRESENTATIVE_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_EFFECTIVE_DATE=2026-08-14
