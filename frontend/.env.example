# Copy this file to frontend/.env for local development.
# Never commit frontend/.env.

API_BASE_URL=http://localhost:8080/api

# Kakao Maps / Kakao platform keys
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_REST_API_KEY=

# Optional Firebase values, if Firebase is enabled later.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
