# Copy this file to frontend/.env.release before a release build.
# Never commit frontend/.env.release or any real secret value.

API_BASE_URL=https://potato-mubwanna.duckdns.org/api

# Kakao Maps / Kakao platform keys
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_REST_API_KEY=
KAKAO_LOGIN_REDIRECT_URI=

# Firebase values required by Android release builds
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=

# Legal notices required by release builds
LEGAL_BUSINESS_NAME=
LEGAL_REPRESENTATIVE_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_EFFECTIVE_DATE=2026-08-14
