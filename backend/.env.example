# Copy this file to backend/.env for local development.
# Never commit backend/.env.

DB_URL=jdbc:postgresql://localhost:15432/potato_mubwanna
DB_USERNAME=potato
DB_PASSWORD=potato

REDIS_HOST=localhost
REDIS_PORT=6379

# Server-side Kakao API keys.
# Do not expose Admin keys or REST API keys to the frontend unless the API explicitly requires it.
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
KAKAO_LOCAL_KEYWORD_SEARCH_URL=https://dapi.kakao.com/v2/local/search/keyword.json
KAKAO_LOCAL_SPOT_KEYWORDS=강원 감자빵,강릉 감자빵,춘천 감자 카페,평창 감자 체험,강원 감자전,강원 옹심이,강원 알감자,강원 로컬푸드 감자,강원 감자 맥주,강원 감자 직판장

# Korea Tourism Organization TourAPI.
# Store the Decoding service key in backend/.env only.
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SEARCH_KEYWORD_PATH=/searchKeyword2
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=potato-mubwanna
TOUR_API_LEGAL_REGION_CODE=51
TOUR_API_SPOT_KEYWORDS=감자,감자빵,감자전,옹심이,감자옹심이,감자떡,알감자,회오리감자,감자체험,감자축제,감자꽃,감자밭,전통시장 감자,로컬푸드 감자,감자 맥주
TOUR_API_IMPORT_ON_STARTUP=false
TOUR_API_IMPORT_PAGE_SIZE=50
TOUR_API_IMPORT_MAX_PAGES=1

# Korea Tourism Organization Odii audio guide API.
# Apply for Odii API access and store the issued service key in backend/.env only.
ODII_API_BASE_URL=https://apis.data.go.kr/B551011/Odii
ODII_API_STORY_SEARCH_PATH=/storySearchList
ODII_API_SERVICE_KEY=
ODII_API_MOBILE_OS=ETC
ODII_API_MOBILE_APP=potato-mubwanna
ODII_API_LANGUAGE=ko

# Korea Tourism Organization related tourism API.
# Apply for TarRlteTarService1 access and store the issued service key in backend/.env only.
RELATED_TOURISM_API_BASE_URL=https://apis.data.go.kr/B551011/TarRlteTarService1
RELATED_TOURISM_API_SEARCH_KEYWORD_PATH=/searchKeyword1
RELATED_TOURISM_API_SERVICE_KEY=
RELATED_TOURISM_API_MOBILE_OS=ETC
RELATED_TOURISM_API_MOBILE_APP=potato-mubwanna
RELATED_TOURISM_API_BASE_YM=202504
RELATED_TOURISM_API_AREA_CODE=51

# Auth/signing secret for future JWT/session features.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
