# Copy this file to backend/.env for local development.
# Never commit backend/.env.

DB_URL=jdbc:postgresql://localhost:15432/potato_mubwanna
DB_USERNAME=potato
DB_PASSWORD=potato

REDIS_HOST=localhost
REDIS_PORT=6379

# Server-side Kakao API keys.
# Do not expose Admin keys or REST API keys to the frontend unless the API explicitly requires it.
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=

# Korea Tourism Organization TourAPI.
# Store the Decoding service key in backend/.env only.
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=potato-mubwanna

# Auth/signing secret for future JWT/session features.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
