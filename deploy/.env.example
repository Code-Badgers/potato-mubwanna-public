BACKEND_IMAGE=potato-mubwanna-backend:latest
PUBLIC_DOMAIN=potato-mubwanna.duckdns.org

DB_NAME=potato_mubwanna
DB_USERNAME=potato
DB_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
COUPON_QR_SECRET=replace-with-another-32-byte-random-secret
COUPON_QR_TTL_SECONDS=300

KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=
TOUR_API_SERVICE_KEY=
ODII_API_SERVICE_KEY=
RELATED_TOURISM_API_SERVICE_KEY=
CONGESTION_API_SERVICE_KEY=

TOUR_API_IMPORT_ON_STARTUP=false
CONGESTION_API_SYNC_ON_STARTUP=false
CONGESTION_API_SYNC_DAILY=false
# 한국시간 매일 오전 6시 15분. 승인된 집중률 API 키와 함께 사용합니다.
CONGESTION_API_SYNC_CRON=0 15 6 * * *

FIREBASE_ADMIN_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
PUSH_TOKEN_STALE_DAYS=60
